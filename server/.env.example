PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/srps_reports
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
ADMIN_EMAIL=admin@srps.local
ADMIN_PASSWORD=your-6-to-20-chars

# Cloudinary private storage for student images and published report PDFs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# APITxT WhatsApp integration
APITXT_API_KEY=
APITXT_AUTHKEY=
APITXT_PROJECT_REF_ID=
APITXT_TEMPLATE_NAME=
APITXT_WEBHOOK_SECRET=
WA_LINK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Nodemailer SMTP for password-reset and Report Drive OTP emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SRPS Report Drive <no-reply@your-school.example>"
