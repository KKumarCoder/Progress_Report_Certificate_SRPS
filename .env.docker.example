# Copy to .env next to compose.yaml and replace these three values.
# Use a long alphanumeric Mongo password (URI-safe; no @ : / ? # %).
MONGO_PASSWORD=REPLACE_WITH_UNIQUE_MONGO_PASSWORD
ADMIN_EMAIL=admin@your-school.example
ADMIN_PASSWORD=your-6-to-20-chars
# Local Docker uses HTTP. Use production and your HTTPS origin for deployment.
NODE_ENV=development
APP_ORIGIN=http://localhost:4000

# Nodemailer SMTP for password-reset emails. Set real values locally.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ANVAYROBO <no-reply@your-school.example>"
# APP_ORIGIN above must be the URL staff open (HTTPS in production).
